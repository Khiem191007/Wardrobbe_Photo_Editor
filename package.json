{
  "name": "lumen",
  "version": "1.0.0",
  "description": "AI photo editor powered by Google Gemini",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./backend\" --filter \"./frontend\" dev",
    "build": "pnpm --filter \"./frontend\" build",
    "start": "pnpm --filter \"./backend\" start",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
